# Môi trường demo chạy bằng Docker (xem docs/setup/docker.md).
# Container `app` tự copy file này thành .env và sinh APP_KEY ở lần chạy đầu.
# Session/cache/queue dùng database, mail ghi log: đều là default trong config/, không cần khai báo.

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
AUTH_REGISTRATION_ENABLED=false

# Watcher đọc storage/logs/laravel.log, giữ channel `single`.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# compose.yaml cũng đặt các biến này cho container `app`.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sentinel
DB_USERNAME=sentinel
DB_PASSWORD=sentinel
